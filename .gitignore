# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw source photos pulled from the old Wix site. Reproducible from
# raw-images/urls.txt, so the originals and contact sheets stay out of git.
raw-images/src-*
raw-images/sheet-*

# Convex agent skills — regenerate with `npx convex ai-files install`.
.agents/skills/
.claude/skills/
